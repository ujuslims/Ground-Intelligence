# Copy to .env for local development. Never commit a real .env file --
# .gitignore already excludes it.

GI_ENVIRONMENT=development

# --- Database ---
# Local dev (docker-compose Postgres, see infra/docker-compose.yml):
GI_DATABASE_URL=postgresql+psycopg2://gi:gi@localhost:5432/ground_intelligence
#
# Supabase (staging/production) -- from Project Settings > Database >
# Connection string > URI, then swap "postgresql://" for
# "postgresql+psycopg2://":
# GI_DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Sessions ---
GI_SESSION_COOKIE_NAME=gi_session
GI_SESSION_TTL_MINUTES=720
GI_SESSION_IDLE_TIMEOUT_MINUTES=120
GI_COOKIE_SECURE=false
GI_COOKIE_SAMESITE=lax
# In production, if the frontend and backend are on different domains
# (e.g. Netlify + Render), use SAMESITE=none and COOKIE_SECURE=true
# instead -- see docs/DEPLOYMENT.md, "Known incident: CORS and cookies".

# --- CORS ---
# The frontend's real URL, no trailing slash. Required in any deployment
# where frontend and backend are on different origins -- without this the
# browser blocks every request from the frontend before this app sees it.
GI_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Storage ---
# Local dev (MinIO, see infra/docker-compose.yml):
GI_STORAGE_PROVIDER=s3
GI_STORAGE_BUCKET=ground-intelligence-dev
GI_STORAGE_ENDPOINT_URL=http://localhost:9000
GI_STORAGE_REGION=us-east-1
GI_STORAGE_ACCESS_KEY=minioadmin
GI_STORAGE_SECRET_KEY=minioadmin
#
# Supabase Storage (staging/production) -- from Storage > S3 Connection
# in the Supabase dashboard:
# GI_STORAGE_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# GI_STORAGE_REGION=<project-region>
# GI_STORAGE_ACCESS_KEY=<generated access key>
# GI_STORAGE_SECRET_KEY=<generated secret key>

# --- GeoBrain LLM provider ---
GI_GEOBRAIN_LLM_PROVIDER=anthropic
GI_GEOBRAIN_LLM_MODEL=claude-sonnet-4-6

# --- Bootstrap administrator (app/seed.py) ---
# Use a real, valid email address here in any deployed environment --
# pydantic's email validation rejects .local/.test/.invalid/.localhost
# domains outright (they're IANA special-use domains), so a placeholder
# like admin@pigl.local will fail at the very first login attempt.
GI_BOOTSTRAP_ADMIN_EMAIL=admin@pigl.example
GI_BOOTSTRAP_ADMIN_PASSWORD=changeme-set-a-real-password
